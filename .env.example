# --- Database (Postgres) ---
# Neon: `neon env pull` writes the pooled string here and the direct one (for migrations)
# in DATABASE_URL_UNPOOLED.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crm"
# DATABASE_URL_UNPOOLED="postgresql://..."

# --- Auth.js ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Public URL of the app; optional (the request Host header is trusted otherwise).
# AUTH_URL="https://crm.example.com"
# Optional "Sign in with Google" (button appears only when both are set).
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# --- Card reading (vision AI) ---
# gemini (free tier) | openai | anthropic
VISION_PROVIDER="gemini"
GEMINI_API_KEY=""
# Comma-separated; the next one is tried when a model is busy or out of quota.
# GEMINI_MODELS="gemini-flash-latest,gemini-flash-lite-latest"
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o"
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-sonnet-4-5"

# --- Limits ---
# Who may create an account: comma-separated emails and/or @domains. Empty = anyone.
# SIGNUP_ALLOWLIST="me@gmail.com,@mycompany.com"
# New accounts come through Google sign-in (verified email). Set to true to also allow
# email + password sign-up, e.g. for local dev or self-hosting without Google.
# ALLOW_PASSWORD_SIGNUP=false
# Card reads (uploads + retries) per account per 24 hours.
# SCAN_DAILY_LIMIT=20

# --- Image storage ---
# Any S3-compatible store (Neon Object Storage, AWS S3, Cloudflare R2, MinIO, ...). Leave
# S3_BUCKET empty to save images on local disk in UPLOAD_DIR instead (self-hosting only).
# Neon: set S3_BUCKET="card-images"; endpoint, region and keys come from the AWS_* vars
# (AWS_ENDPOINT_URL_S3, AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY) that
# `neon env pull` writes, so leave the S3_* lines below unset locally. On Vercel those AWS_* names
# are reserved: copy the values into S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY, S3_REGION and S3_ENDPOINT.
# S3_BUCKET=""
# S3_REGION="auto"
# S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_FORCE_PATH_STYLE=false
# UPLOAD_DIR="./uploads"
