# --- Database (Postgres) ---
# Neon: use the pooled connection string here and the direct one in DIRECT_URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crm"
# DIRECT_URL="postgresql://..."

# --- Auth.js ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Public URL of the app; optional (the request Host header is trusted otherwise).
# AUTH_URL="https://crm.example.com"
# Optional "Sign in with Google" (button appears only when both are set).
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# --- Card reading (vision AI) ---
# gemini (free tier) | openai | anthropic
VISION_PROVIDER="gemini"
GEMINI_API_KEY=""
# Comma-separated; the next one is tried when a model is busy or out of quota.
# GEMINI_MODELS="gemini-flash-latest,gemini-flash-lite-latest"
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o"
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-sonnet-4-5"

# --- Limits ---
# Who may create an account: comma-separated emails and/or @domains. Empty = anyone.
# SIGNUP_ALLOWLIST="me@gmail.com,@mycompany.com"
# New accounts come through Google sign-in (verified email). Set to true to also allow
# email + password sign-up, e.g. for local dev or self-hosting without Google.
# ALLOW_PASSWORD_SIGNUP=false
# Card reads (uploads + retries) per account per 24 hours.
# SCAN_DAILY_LIMIT=20

# --- Image storage ---
# Any S3-compatible store (AWS S3, Cloudflare R2, MinIO, ...). Leave S3_BUCKET empty
# to save images on local disk in UPLOAD_DIR instead (self-hosting only).
# S3_BUCKET=""
# S3_REGION="auto"
# S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_FORCE_PATH_STYLE=false
# UPLOAD_DIR="./uploads"
